<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>$(LineTfm)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Community.ArchivedUsers</RootNamespace>
    <!-- Client assets in wwwroot are served at /App_Plugins/ArchivedUsers/ via static web assets -->
    <StaticWebAssetBasePath>App_Plugins/ArchivedUsers</StaticWebAssetBasePath>
    <!-- Audit direct and transitive dependencies; build/check-vulnerable.sh is the release gate (AU-15, T21) -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.ArchivedUsers</PackageId>
    <VersionPrefix>$(UmbracoMajor).$(PackageMinor).$(PackagePatch)</VersionPrefix>
    <VersionSuffix>$(PackageVersionSuffix)</VersionSuffix>
    <Authors>Pascal Meyer</Authors>
    <Description>Tidy away ex-staff and old agency users. Archive leavers so they drop out of the Users list and user pickers, without deleting them. Archiving disables them, and every archive records who, whom, when and why.</Description>
    <Copyright>Copyright © Pascal Meyer</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/PascalA94/Umbraco.Community.ArchivedUsers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PascalA94/Umbraco.Community.ArchivedUsers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco;umbraco-marketplace;users;user-management;archive;offboarding;backoffice;audit;security;governance;plugin;package</PackageTags>
    <!-- 19 release candidate only: label the description and keep it off the Marketplace, which lists no prerelease-only
         packages. Both read the values above, so they stay after them. Drop both at 19.0.0 stable. -->
    <Description Condition="'$(UmbracoMajor)' == '19'">$(Description) Built against Umbraco 19.0.0-rc1, not yet verified on 19 stable.</Description>
    <PackageTags Condition="'$(UmbracoMajor)' == '19'">$(PackageTags.Replace('umbraco-marketplace;',''))</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- NU5104 (stable package, prerelease dependency) comes from the deliberate -0 upper bound of UmbracoRange in
         Directory.Build.props, which keeps the next major's prereleases out. The lower bound is a stable floor, so
         consumers still resolve the same version. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <!-- Debugging support: Source Link plus a .snupkg symbol package -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Deterministic, path-normalised builds in CI so published binaries are reproducible -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Floors: first releases where core refuses disabled users at sign-in, and above the
         27 Oct 2026 advisories. Never lower them without re-opening AU-02 (docs/design.md section 10).
         The floors come from Directory.Build.props (UmbracoRange). -->
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoRange)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoRange)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <!-- The client source is not package content; only the built wwwroot assets ship -->
    <Content Remove="Client\**" />
    <!-- Per-line lock files (packages.<line>.lock.json) match the Razor SDK's default Content globs and would ship in the nupkg. -->
    <Content Remove="packages.*.lock.json" />
    <None Include="Client\**" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.ArchivedUsers.Tests" />
    <InternalsVisibleTo Include="Umbraco.Community.ArchivedUsers.IntegrationTests" />
    <!-- NSubstitute proxies for internal types -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
