<Project>
  <!--
    Lock files describe the floor: they are generated and committed at the default values of
    UmbracoTestVersion and UmbracoDemoVersion below, and the floor CI leg restores with locked mode.
    A latest-minor leg overrides these two properties and restores unlocked
    (force-evaluate, RestoreLockedMode=false); its rewritten lock files are never committed.
    Nothing else overrides these properties. See docs/plan.md, Global Constraints P1.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UmbracoTestVersion Condition="'$(UmbracoTestVersion)' == ''">17.8.0</UmbracoTestVersion>
    <UmbracoDemoVersion Condition="'$(UmbracoDemoVersion)' == ''">17.8.0</UmbracoDemoVersion>
    <!-- UserKind.Api exists on 17.8 and 18, so both lines define this (plan P13a). -->
    <DefineConstants>$(DefineConstants);UMBRACO_HAS_API_USERS</DefineConstants>
  </PropertyGroup>
</Project>
